rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Group IDs are SHA-256 hashes of your private group code. Collection listing is denied.
    match /groups/{groupId} {
      allow get, create, update: if request.auth != null;
      allow list, delete: if false;

      match /profiles/{profileId} {
        allow get, list, create, update: if request.auth != null
          && profileId in ['rose', 'aiden', 'adrian'];
        allow delete: if false;
      }
    }
  }
}
